# GrowthScout AI Environment Configuration Example
# Copy this file to .env and configure the keys accordingly.

# ==============================================================================
# 1. ENVIRONMENT METADATA
# ==============================================================================
GROWTHSCOUT_ENV=development  # options: development, staging, production

# ==============================================================================
# 2. API CREDENTIALS
# ==============================================================================
# Required for live search queries, analysis, and LLM calls
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Path to Google Service Account Credentials JSON if using Firestore
GOOGLE_APPLICATION_CREDENTIALS=

# ==============================================================================
# 3. SCRAPER SETTINGS
# ==============================================================================
SCRAPER_USER_AGENT=GrowthScoutBot/1.0
SCRAPER_RATE_LIMIT_DELAY=1.0

# ==============================================================================
# 4. TIMEOUTS & RETRIES
# ==============================================================================
HTTP_TIMEOUT_SECONDS=30.0
WORKER_TIMEOUT_SECONDS=60.0
MCP_TIMEOUT_SECONDS=30.0
FIRESTORE_TIMEOUT_SECONDS=15.0
WORKFLOW_TIMEOUT_SECONDS=600.0

MAX_RETRIES=3
BACKOFF_FACTOR=2.0

# ==============================================================================
# 5. CACHE CONFIGURATION
# ==============================================================================
# Cache TTLs in seconds
CACHE_TTL_DISCOVERY=3600.0
CACHE_TTL_AUDIT=86400.0

# ==============================================================================
# 6. CIRCUIT BREAKERS
# ==============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60.0
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=1

# ==============================================================================
# 7. BUDGET LIMITS
# ==============================================================================
# Max request counts and costs permitted per workflow session
MAX_GEMINI_REQUESTS=20
MAX_MAPS_REQUESTS=15
MAX_PAGES_CRAWLED=10
MAX_ELAPSED_SECONDS=600.0
MAX_COST_LIMIT=5.00

# ==============================================================================
# 8. PERSISTENCE CHECKPOINT BACKEND
# ==============================================================================
# Defines the checkpoint store mechanism
CHECKPOINT_BACKEND=in_memory  # options: in_memory, firestore
