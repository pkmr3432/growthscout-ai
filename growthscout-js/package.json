{
  "name": "growthscout-js",
  "version": "1.0.0-rc1",
  "description": "Official TypeScript and JavaScript client SDK for the GrowthScout AI Platform",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "npm run build:esm && npm run build:cjs",
    "clean": "rm -rf dist",
    "test": "jest"
  },
  "author": "GrowthScout AI Team <support@growthscout.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkmr3432/growthscout-ai.git"
  },
  "keywords": [
    "growthscout",
    "ai",
    "agent",
    "sdk",
    "api-client",
    "typescript"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
